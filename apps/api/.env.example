# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# CORS — origin of the web app (apps/web)
WEB_ORIGIN=http://localhost:5173

# Cookie signing secret (min 16 chars, change in production)
COOKIE_SECRET=dev-cookie-secret-change-me-32chars

# Postgres — points to the docker-compose db service in dev
DATABASE_URL=postgresql://bukit:bukit@localhost:5435/bukit?schema=public

# Better-Auth secret (min 32 chars, change in production)
AUTH_SECRET=dev-auth-secret-change-me-32chars-or-more

# Public URL the API is reachable at (used by Better-Auth for cookies/baseURL)
API_PUBLIC_URL=http://localhost:3001

# HelixPay (PH payment gateway) — replace with sandbox creds when integrating
HELIXPAY_BASE_URL=https://api.helixpay.ph
HELIXPAY_API_KEY=sandbox-helixpay-api-key
HELIXPAY_WEBHOOK_SECRET=sandbox-helixpay-webhook-secret-min-32chars

# PhilSMS (PH SMS provider for phone OTP)
PHILSMS_BASE_URL=https://app.philsms.com/api/v3
PHILSMS_API_KEY=
PHILSMS_SENDER_ID=PhilSMS
