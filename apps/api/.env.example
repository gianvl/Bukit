# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# CORS — origin of the web app (apps/web)
WEB_ORIGIN=http://localhost:5173

# Cookie signing secret (min 16 chars, change in production)
COOKIE_SECRET=dev-cookie-secret-change-me-32chars

# Postgres — points to the docker-compose db service in dev
DATABASE_URL=postgresql://bukit:bukit@localhost:5435/bukit?schema=public
